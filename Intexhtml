    <script>
        // Tab Navigation System
        function showTab(tabId) {
            const views = document.querySelectorAll('.tab-view');
            views.forEach(v => v.classList.add('hidden'));

            const target = document.getElementById('view-' + tabId);
            if (target) {
                target.classList.remove('hidden');
            }

            // Update Tab Active Styling
            const tabs = document.querySelectorAll('.nav-tab');
            tabs.forEach(t => {
                t.classList.remove('text-purple-300', 'bg-purple-950/60', 'border', 'border-purple-500/30');
                t.classList.add('text-slate-400');
            });

            const activeBtn = document.getElementById('nav-btn-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('text-purple-300', 'bg-purple-950/60', 'border', 'border-purple-500/30');
                activeBtn.classList.remove('text-slate-400');
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Hero Audio Visualizer Toggle Simulation
        let isHeroPlaying = false;
        function toggleHeroVisualizer() {
            isHeroPlaying = !isHeroPlaying;
            const heroBars = document.getElementById('hero-bars');
            const heroIcon = document.getElementById('hero-play-icon');

            if (isHeroPlaying) {
                heroBars.classList.remove('paused-bars');
                heroIcon.classList.remove('fa-play');
                heroIcon.classList.add('fa-pause');
            } else {
                heroBars.classList.add('paused-bars');
                heroIcon.classList.remove('fa-pause');
                heroIcon.classList.add('fa-play');
            }
        }

        // Main Music Player Logic Simulation
        let isAudioPlaying = false;

        function playTrack(title, artist, modeText, lyricKey) {
            document.getElementById('player-song-title').innerText = title;
            document.getElementById('player-artist-name').innerText = artist;
            document.getElementById('player-mode-text').innerText = modeText;

            isAudioPlaying = true;
            updateMainPlayerUI();
        }

        function toggleAudioPlayer() {
            isAudioPlaying = !isAudioPlaying;
            updateMainPlayerUI();
        }

        function updateMainPlayerUI() {
            const icon = document.getElementById('main-play-icon');
            const bars = document.getElementById('player-bars-widget');

            if (isAudioPlaying) {
                icon.classList.remove('fa-play');
                icon.classList.add('fa-pause');
                bars.classList.remove('paused-bars');
            } else {
                icon.classList.remove('fa-pause');
                icon.classList.add('fa-play');
                bars.classList.add('paused-bars');
            }
        }

